# Copy this file to ".env" and fill in the two secrets marked REPLACE_ME.
# The .env file is git-ignored and must NEVER be committed.

# ---- OpenAI (gpt-4o-mini job extraction) ----
# Create a key at https://platform.openai.com/api-keys (needs a few $ of credit)
OPENAI_API_KEY=REPLACE_ME_openai_key

# ---- Email digest (Gmail SMTP over SSL) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=architshukla546@gmail.com
# NOT your Gmail login password. Create a Gmail App Password (needs 2FA):
# https://myaccount.google.com/apppasswords
SMTP_PASS=REPLACE_ME_gmail_app_password
EMAIL_FROM=architshukla546@gmail.com
EMAIL_TO=Archit.Shukla@colorado.edu

# ---- Loop cadence (seconds). 900 = 15 min. ----
BATCH_INTERVAL_SECONDS=900
EMAIL_INTERVAL_SECONDS=900
